# Copy to .env and fill in. docker-compose.yml refuses to start without PERKEEP_PG_PASSWORD
# even when PERKEEP_INDEX_BACKEND=sqlite, since the postgres service is always part of this
# stack (kept running so a later switch to postgres doesn't need a fresh container).

PERKEEP_PG_USER=perkeep
PERKEEP_PG_PASSWORD=change-me

# sqlite (default) or postgres -- see docker-compose.yml's top comment for the two-boot
# sequence switching this requires.
PERKEEP_INDEX_BACKEND=sqlite

# Leave both empty to keep perkeepd's default "localhost" auth (fine behind no reverse proxy
# on a plain bridge network; see doc/server-config.md's auth section for why that default is
# dangerous specifically behind a reverse proxy, which this compose stack does not have).
PERKEEP_WEB_USER=
PERKEEP_WEB_PASSWORD=

PERKEEP_BASE_URL=
